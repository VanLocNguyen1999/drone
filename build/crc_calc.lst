  12:sdk/utils/crc_calc/crc_calc.c **** uint8_t crc_calculate_8bit(const uint8_t *Buffer, uint16_t Length) {
  13:sdk/utils/crc_calc/crc_calc.c **** 	uint8_t retVal = 0u;
  14:sdk/utils/crc_calc/crc_calc.c **** 	uint16_t byteIndex = 0u;
  15:sdk/utils/crc_calc/crc_calc.c **** 
  16:sdk/utils/crc_calc/crc_calc.c **** 	if (Buffer != NULL) {
  17:sdk/utils/crc_calc/crc_calc.c **** 		uint8_t bitIndex = 0u;
  18:sdk/utils/crc_calc/crc_calc.c **** 
  19:sdk/utils/crc_calc/crc_calc.c **** 		retVal = CRC_8_INIT_VALUE;
  20:sdk/utils/crc_calc/crc_calc.c **** 
  21:sdk/utils/crc_calc/crc_calc.c **** 		/* Do calculation procedure for each byte */
  22:sdk/utils/crc_calc/crc_calc.c **** 		for (byteIndex = 0u; byteIndex < Length; byteIndex++) {
  23:sdk/utils/crc_calc/crc_calc.c **** 			/* XOR new byte with temp result */
  24:sdk/utils/crc_calc/crc_calc.c **** 			retVal ^= (Buffer[byteIndex] << (CRC_8_RESULT_WIDTH - 8u));
  25:sdk/utils/crc_calc/crc_calc.c **** 
  26:sdk/utils/crc_calc/crc_calc.c **** 			/* Do calculation for current data */
  27:sdk/utils/crc_calc/crc_calc.c **** 			for (bitIndex = 0u; bitIndex < 8u; bitIndex++) {
  28:sdk/utils/crc_calc/crc_calc.c **** 				if (retVal & (1u << (CRC_8_RESULT_WIDTH - 1u))) {
  29:sdk/utils/crc_calc/crc_calc.c **** 					retVal = (uint8_t) ((retVal << 1u) ^ CRC_8_POLYNOMIAL);
  30:sdk/utils/crc_calc/crc_calc.c **** 				} else {
ARM GAS  C:\Users\vanlo\AppData\Local\Temp\ccdwQer7.s 			page 2


  31:sdk/utils/crc_calc/crc_calc.c **** 					retVal = (retVal << 1u);
  32:sdk/utils/crc_calc/crc_calc.c **** 				}
  33:sdk/utils/crc_calc/crc_calc.c **** 			}
  34:sdk/utils/crc_calc/crc_calc.c **** 		}
  35:sdk/utils/crc_calc/crc_calc.c **** 
  36:sdk/utils/crc_calc/crc_calc.c **** 		/* XOR result with specified value */
  37:sdk/utils/crc_calc/crc_calc.c **** 		retVal ^= CRC_8_XOR_VALUE;
  38:sdk/utils/crc_calc/crc_calc.c **** 	}
  39:sdk/utils/crc_calc/crc_calc.c **** 
  40:sdk/utils/crc_calc/crc_calc.c **** 	return retVal;
  41:sdk/utils/crc_calc/crc_calc.c **** }
