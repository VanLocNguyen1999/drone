  33:sdk/common/attitude/attitude.c **** 
  34:sdk/common/attitude/attitude.c **** int32_t sm_attitude_est_set_gain(sm_attitude_t *this, float kp, float ki) {
  35:sdk/common/attitude/attitude.c **** 
  36:sdk/common/attitude/attitude.c **** 	if (!this || !isfinite(kp) || !isfinite(ki) || kp < 0.0f || ki < 0.0f)
  37:sdk/common/attitude/attitude.c **** 		return -1;
  38:sdk/common/attitude/attitude.c **** 	this->kp = kp;
  39:sdk/common/attitude/attitude.c **** 	this->ki = ki;
  40:sdk/common/attitude/attitude.c **** 	if (ki == 0.0f) {
  41:sdk/common/attitude/attitude.c **** 		this->integral_x = 0.0f;
  42:sdk/common/attitude/attitude.c **** 		this->integral_y = 0.0f;
  43:sdk/common/attitude/attitude.c **** 		this->integral_z = 0.0f;
  44:sdk/common/attitude/attitude.c **** 	}
  45:sdk/common/attitude/attitude.c **** 	return 0;
  46:sdk/common/attitude/attitude.c **** }
