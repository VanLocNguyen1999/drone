  48:sdk/common/attitude/attitude.c **** static void sm_attitude_est_correct_gyro(sm_attitude_t *this, const mpu6050_data_t *data, float gyr
  49:sdk/common/attitude/attitude.c **** {
  50:sdk/common/attitude/attitude.c **** 	float ax = data->accel_x;
  51:sdk/common/attitude/attitude.c **** 	float ay = data->accel_y;
  52:sdk/common/attitude/attitude.c **** 	float az = data->accel_z;
  53:sdk/common/attitude/attitude.c **** 
  54:sdk/common/attitude/attitude.c **** 	float norm = sqrtf(ax * ax + ay * ay + az * az);
  55:sdk/common/attitude/attitude.c **** 	if (norm > 0.8f && norm < 1.2f) {
  56:sdk/common/attitude/attitude.c **** 		ax /= norm;
  57:sdk/common/attitude/attitude.c **** 		ay /= norm;
  58:sdk/common/attitude/attitude.c **** 		az /= norm;
  59:sdk/common/attitude/attitude.c **** 
  60:sdk/common/attitude/attitude.c **** 		float q0 = this->q0;
  61:sdk/common/attitude/attitude.c **** 		float q1 = this->q1;
  62:sdk/common/attitude/attitude.c **** 		float q2 = this->q2;
  63:sdk/common/attitude/attitude.c **** 		float q3 = this->q3;
  64:sdk/common/attitude/attitude.c **** 
  65:sdk/common/attitude/attitude.c **** 		// Estimated gravity
  66:sdk/common/attitude/attitude.c **** 		float vx = 2.0f * (q1 * q3 - q0 * q2);
  67:sdk/common/attitude/attitude.c **** 		float vy = 2.0f * (q0 * q1 + q2 * q3);
  68:sdk/common/attitude/attitude.c **** 		float vz = q0 * q0 - q1 * q1 - q2 * q2 + q3 * q3;
  69:sdk/common/attitude/attitude.c **** 
  70:sdk/common/attitude/attitude.c **** 		// Cross-product error
  71:sdk/common/attitude/attitude.c **** 		float ex = ay * vz - az * vy;
  72:sdk/common/attitude/attitude.c **** 		float ey = az * vx - ax * vz;
  73:sdk/common/attitude/attitude.c **** 		float ez = ax * vy - ay * vx;
  74:sdk/common/attitude/attitude.c **** 
  75:sdk/common/attitude/attitude.c **** 		if (this->ki > 0.0f) {
  76:sdk/common/attitude/attitude.c **** 			this->integral_x += this->ki * ex * dt;
  77:sdk/common/attitude/attitude.c **** 			this->integral_y += this->ki * ey * dt;
  78:sdk/common/attitude/attitude.c **** 			this->integral_z += this->ki * ez * dt;
  79:sdk/common/attitude/attitude.c **** 
  80:sdk/common/attitude/attitude.c **** 			this->integral_x = fmaxf(-INTEGRAL_LIMIT,fminf(INTEGRAL_LIMIT, this->integral_x));
  81:sdk/common/attitude/attitude.c **** 			this->integral_y = fmaxf(-INTEGRAL_LIMIT,fminf(INTEGRAL_LIMIT, this->integral_y));
  82:sdk/common/attitude/attitude.c **** 			this->integral_z = fmaxf(-INTEGRAL_LIMIT,fminf(INTEGRAL_LIMIT, this->integral_z));
  83:sdk/common/attitude/attitude.c **** 		}
  84:sdk/common/attitude/attitude.c **** 
  85:sdk/common/attitude/attitude.c **** 		gyro[0] += this->kp * ex;
  86:sdk/common/attitude/attitude.c **** 		gyro[1] += this->kp * ey;
  87:sdk/common/attitude/attitude.c **** 		gyro[2] += this->kp * ez;
ARM GAS  C:\Users\vanlo\AppData\Local\Temp\cc5dR21o.s 			page 3


  88:sdk/common/attitude/attitude.c **** 	}
  89:sdk/common/attitude/attitude.c **** 
  90:sdk/common/attitude/attitude.c **** 	gyro[0] += this->integral_x;
  91:sdk/common/attitude/attitude.c **** 	gyro[1] += this->integral_y;
  92:sdk/common/attitude/attitude.c **** 	gyro[2] += this->integral_z;
  93:sdk/common/attitude/attitude.c **** }
